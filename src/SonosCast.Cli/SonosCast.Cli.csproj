<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform command-line SonosCast for macOS and Linux (also runs on Windows). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sonoscast</AssemblyName>
    <RootNamespace>SonosCast.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonosCast.Core\SonosCast.Core.csproj" />
  </ItemGroup>

</Project>
